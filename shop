<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VeloFlow 原型｜AI 電商爆款矩陣與帶貨影音工作室</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
              900: '#4c1d95',
            },
            shopee: '#ee4d2d'
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap');
    body { font-family: 'Plus Jakarta Sans', 'Noto Sans TC', system-ui, sans-serif; }
    .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

  <!-- 通知 Toast 浮動視窗 (替代原生 alert) -->
  <div id="toastNotification" class="fixed top-5 right-5 z-50 transform translate-y-[-150%] opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-2.5 bg-slate-900 border border-slate-700 text-white px-4 py-3 rounded-2xl shadow-2xl text-xs font-semibold">
    <span id="toastIcon" class="text-base">✨</span>
    <span id="toastMessage">操作成功</span>
  </div>

  <!-- 頂部商業 SaaS 導航欄 -->
  <header class="bg-slate-900/90 border-b border-slate-800 sticky top-0 z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-600 via-indigo-500 to-shopee flex items-center justify-center text-white font-black text-xl shadow-lg shadow-brand-500/20 ring-1 ring-white/20">
          V
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-1.5">
              VeloFlow 概念架構
              <span class="text-[10px] bg-brand-500/20 text-brand-300 border border-brand-500/30 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">
                AI 電商鐵軍版
              </span>
            </h1>
          </div>
          <p class="text-xs text-slate-400">選品情報探測 ． 帶貨短影音分鏡 ． 台灣合規洗白 ． 實時利潤精算</p>
        </div>
      </div>

      <!-- 快捷操作與商業模式入口 -->
      <div class="flex items-center gap-2">
        <button onclick="switchTab('tab-architecture')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold py-2 px-3 rounded-xl transition flex items-center gap-1.5">
          <span>🛠️</span>
          <span>App 開發架構藍圖</span>
        </button>
        <button onclick="runAutoPipeline()" class="text-xs bg-gradient-to-r from-brand-600 to-shopee hover:opacity-95 text-white font-bold py-2 px-3.5 rounded-xl transition flex items-center gap-1.5 shadow-md shadow-brand-500/20">
          <span class="animate-pulse">⚡</span>
          <span>一鍵跑通選品到影音</span>
        </button>
      </div>
    </div>

    <!-- 模組標籤導航欄 -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex space-x-1 sm:space-x-3 border-t border-slate-800/80 overflow-x-auto text-xs font-semibold">
      <button onclick="switchTab('tab-video-studio')" id="btn-tab-video-studio" class="tab-btn py-3 px-3.5 border-b-2 font-bold text-brand-400 border-brand-500 flex items-center gap-1.5 whitespace-nowrap transition">
        <span>🎬</span> AI 帶貨影音工作室
      </button>
      <button onclick="switchTab('tab-radar')" id="btn-tab-radar" class="tab-btn py-3 px-3.5 border-b-2 text-slate-400 border-transparent hover:text-slate-200 flex items-center gap-1.5 whitespace-nowrap transition">
        <span>🔥</span> 爆品探測雷達
      </button>
      <button onclick="switchTab('tab-compliance')" id="btn-tab-compliance" class="tab-btn py-3 px-3.5 border-b-2 text-slate-400 border-transparent hover:text-slate-200 flex items-center gap-1.5 whitespace-nowrap transition">
        <span>🛡️</span> 台灣法規洗白雷達
      </button>
      <button onclick="switchTab('tab-finance')" id="btn-tab-finance" class="tab-btn py-3 px-3.5 border-b-2 text-slate-400 border-transparent hover:text-slate-200 flex items-center gap-1.5 whitespace-nowrap transition">
        <span>💰</span> 蝦皮抽成利潤模型
      </button>
      <button onclick="switchTab('tab-architecture')" id="btn-tab-architecture" class="tab-btn py-3 px-3.5 border-b-2 text-slate-400 border-transparent hover:text-slate-200 flex items-center gap-1.5 whitespace-nowrap transition">
        <span>🚀</span> 如何做成真實 App？
      </button>
    </div>
  </header>

  <!-- 主內容工作區 -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex-1 w-full space-y-6">

    <!-- ================= TAB 1: AI 帶貨影音工作室 (核心生成模組) ================= -->
    <div id="tab-video-studio" class="tab-content space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- 左側：輸入與控制台 (4 Cols) -->
        <div class="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-5 shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
              <h2 class="text-sm font-bold text-white flex items-center gap-1.5">
                <span>🤖</span> AI 爆款短影音生成器
              </h2>
              <p class="text-[11px] text-slate-400">專為蝦皮短片 / TikTok 演算法調優</p>
            </div>
            <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800/80 px-2 py-0.5 rounded-full font-bold">
              Prompt V3.2
            </span>
          </div>

          <!-- 商品名稱輸入 -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">目標帶貨商品</label>
            <input type="text" id="studioProdName" value="天然粉晶雙頭滾輪＋刮痧板組" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs font-semibold text-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>

          <!-- 核心受眾與痛點 -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">目標客群 (Persona)</label>
              <select id="studioPersona" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-2.5 py-2 text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500">
                <option value="office_girl">25-35 歲都會精緻女孩</option>
                <option value="fitness_beginner">居家輕運動自律族</option>
                <option value="busy_mom">忙碌育兒/舒壓媽咪</option>
                <option value="college_student">大學宿舍小資女</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">主打黃金痛點</label>
              <select id="studioPainPoint" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-2.5 py-2 text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500">
                <option value="morning_puff">早晨起床浮腫沒精神</option>
                <option value="neck_tired">久坐滑手機肩頸僵硬</option>
                <option value="bedtime_stress">睡前焦慮難以放鬆</option>
                <option value="skincare_waste">高價保養品吸收不佳</option>
              </select>
            </div>
          </div>

          <!-- 短影音風格節奏 -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">影片風格與調性</label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-2 p-2.5 bg-slate-800/80 rounded-xl border border-slate-700/80 cursor-pointer hover:border-brand-500 transition">
                <input type="radio" name="videoStyle" value="asmr_spa" checked class="text-brand-500 focus:ring-brand-500">
                <span class="text-xs text-slate-200 font-medium">沉浸式 ASMR 儀式感</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 bg-slate-800/80 rounded-xl border border-slate-700/80 cursor-pointer hover:border-brand-500 transition">
                <input type="radio" name="videoStyle" value="punchy_hook" class="text-brand-500 focus:ring-brand-500">
                <span class="text-xs text-slate-200 font-medium">前3秒強衝擊反差</span>
              </label>
            </div>
          </div>

          <!-- 生成按鈕 -->
          <button onclick="generateAiVideoPackage()" id="btnGenerateAi" class="w-full py-2.5 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-brand-500/30">
            <span id="genIcon">✨</span>
            <span id="genText">一鍵生成帶貨分鏡與合規腳本</span>
          </button>

          <!-- 快速切換預設案例 -->
          <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
            <span>填入推薦品項：</span>
            <div class="flex gap-1.5">
              <button onclick="quickFillStudio('天然粉晶雙頭滾輪組', 'office_girl', 'morning_puff')" class="hover:text-brand-300 underline">粉晶滾輪</button>
              <span>•</span>
              <button onclick="quickFillStudio('高頻負重無繩跳繩', 'fitness_beginner', 'neck_tired')" class="hover:text-brand-300 underline">無繩跳繩</button>
              <span>•</span>
              <button onclick="quickFillStudio('矽膠頭皮深層洗頭梳', 'office_girl', 'bedtime_stress')" class="hover:text-brand-300 underline">洗頭梳</button>
            </div>
          </div>
        </div>

        <!-- 右側：生成的腳本、分鏡卡與 AI 影片 Prompt (8 Cols) -->
        <div class="lg:col-span-8 space-y-5">
          
          <!-- 成果頂部：前3秒爆款 Hook 與帶貨標題 -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs bg-rose-500/20 text-rose-400 border border-rose-500/30 px-2 py-0.5 rounded-md font-bold">
                  💥 3秒致死率 HOOK
                </span>
                <span class="text-xs text-slate-400">買家滑動停留率核心</span>
              </div>
              <button onclick="copyToClipboard('hookContent', 'Hook 文案已複製')" class="text-[11px] text-brand-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-2.5 py-1 rounded-lg border border-slate-700 transition">
                複製 Hook
              </button>
            </div>
            
            <p id="hookContent" class="text-sm sm:text-base font-bold text-white bg-slate-950/70 p-3.5 rounded-xl border border-slate-800 text-rose-100">
              「早起臉沉得像沒睡醒？別再盲目喝黑咖啡了！這個冰冰涼涼的小動作，懂精緻保養的女孩都在偷偷做！」
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] mb-1">蝦皮短片 / TikTok 爆款標題</span>
                <p id="videoTitleContent" class="font-bold text-slate-200">
                  早晨3分鐘喚醒神仙顏值！天然冰感撫平早起沉重感 ✨ #生活美學 #自我寵愛
                </p>
              </div>
              <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] mb-1">合規性檢測結果</span>
                <p id="videoComplianceTag" class="font-bold text-emerald-400 flex items-center gap-1">
                  <span>✅</span> 100% 零違法醫療詞彙，可直接上傳廣告
                </p>
              </div>
            </div>
          </div>

          <!-- 4段式帶貨分鏡表 (Storyboard) -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <span>🎞️</span> 15秒黃金帶貨分鏡腳本 (Storyboard Pipeline)
              </h3>
              <button onclick="copyFullScript()" class="text-[11px] text-brand-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-2.5 py-1 rounded-lg border border-slate-700 transition">
                一鍵複製整篇腳本
              </button>
            </div>

            <!-- 分鏡卡片網格 -->
            <div id="storyboardContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <!-- JS 動態生成分鏡 -->
            </div>
          </div>

          <!-- 給 AI 影片模型 (Sora / Kling / Runway) 的純英文提示詞 Prompt -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                <span>🤖</span> AI 影片生成模型 Prompt (可直接丟 Runway / 可靈 Kling)
              </span>
              <button onclick="copyToClipboard('aiVideoPromptText', 'AI 影片 Prompt 已複製')" class="text-[11px] text-brand-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-2.5 py-1 rounded-lg border border-slate-700 transition">
                複製英文 Prompt
              </button>
            </div>
            <textarea id="aiVideoPromptText" rows="3" readonly class="w-full bg-slate-950 text-slate-300 text-[11px] p-3 rounded-xl border border-slate-800 font-mono focus:outline-none select-all"></textarea>
          </div>

        </div>
      </div>
    </div>

    <!-- ================= TAB 2: 爆品探測雷達 (市場數據源) ================= -->
    <div id="tab-radar" class="tab-content hidden space-y-6">
      <div class="bg-slate-900 rounded-2xl p-5 border border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>🔥</span> 24H / 7D / 30D 動態爆款選品情報庫
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">點擊卡片，直接將商品情報同步導入 AI 影音工作室與財務計算機</p>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <button onclick="setRadarFilter('all')" id="rf-all" class="rf-btn px-3 py-1.5 rounded-lg bg-brand-600 text-white font-bold transition">全部品類</button>
          <button onclick="setRadarFilter('care')" id="rf-care" class="rf-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 transition">居家保養</button>
          <button onclick="setRadarFilter('sport')" id="rf-sport" class="rf-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 transition">輕量體態</button>
        </div>
      </div>

      <!-- 雷達卡片瀑布流 -->
      <div id="radarCardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- JS 動態生成 -->
      </div>
    </div>

    <!-- ================= TAB 3: 台灣法規洗白雷達 (合規模組) ================= -->
    <div id="tab-compliance" class="tab-content hidden space-y-6">
      <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800 space-y-5">
        <div class="border-b border-slate-800 pb-4">
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>🛡️</span> 衛福部文案法規高危字詞「自動洗白」沙盒
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            專門針對美容刮痧、筋膜按摩、輕運動用品，在輸入任何短影音字幕或商品描述時，一秒偵測開罰風險並自動替換為合法美學用詞。
          </p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">待檢測文案輸入框：</label>
          <textarea id="complianceInput" rows="4" oninput="runComplianceScan()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs sm:text-sm text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="輸入文案，例如：這款滾輪能排毒消水腫、瘦臉提拉下巴，還能疏通經絡活血..."></textarea>
        </div>

        <!-- 掃描結果回饋 -->
        <div id="complianceResultCard" class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-300">雷達掃描狀態：</span>
            <span id="complianceBadge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400">尚未輸入文字</span>
          </div>
          <div id="complianceMatchedBadges" class="flex flex-wrap gap-2"></div>
          <div id="complianceRewrittenBox" class="p-3 bg-slate-900 rounded-lg text-xs text-slate-300 space-y-1">
            <p class="text-slate-500">掃描建議將在此處展開...</p>
          </div>
        </div>

        <!-- 快速一鍵套用洗白文案 -->
        <div class="flex justify-end">
          <button onclick="applyComplianceCleanText()" id="btnApplyCleanText" class="hidden text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-4 rounded-xl transition">
            ✨ 一鍵將合規洗白文案同步到影音工作室
          </button>
        </div>
      </div>
    </div>

    <!-- ================= TAB 4: 蝦皮利潤核算模型 (商業後台) ================= -->
    <div id="tab-finance" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- 左側輸入 -->
        <div class="lg:col-span-7 bg-slate-900 rounded-2xl p-6 border border-slate-800 space-y-5">
          <h2 class="text-sm font-bold text-white border-b border-slate-800 pb-3">2026 蝦皮平台費率真實成本核算</h2>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">1688 進貨價 (RMB)</label>
              <input type="number" id="finCny" value="7.8" step="0.1" oninput="calcFinance()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">匯率 (RMB $\rightarrow$ TWD)</label>
              <input type="number" id="finFx" value="4.6" step="0.05" oninput="calcFinance()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">蝦皮預計促銷售價 (NT$)</label>
              <input type="number" id="finPrice" value="269" oninput="calcFinance()" class="w-full bg-slate-800 border border-brand-500/50 rounded-xl px-3 py-2 text-xs font-bold text-brand-300">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">單件頭程空運+耗材 (NT$)</label>
              <input type="number" id="finShipping" value="16" oninput="calcFinance()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800 space-y-2.5">
            <span class="text-xs font-bold text-slate-400">平台活動扣繳勾選：</span>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2.5 bg-slate-800/80 rounded-xl border border-slate-700/80 cursor-pointer">
                <input type="checkbox" id="finFreeShip" checked onchange="calcFinance()" class="text-brand-500 focus:ring-brand-500">
                <span>全店免運方案 (+6%)</span>
              </label>
