        matched.forEach(m => {
          const span = document.createElement('span');
          span.className = "px-2 py-0.5 bg-rose-900/60 text-rose-300 border border-rose-700/60 text-[10px] font-bold rounded";
          span.innerText = `⚠️ 違規詞：${m.word}`;
          badgeBox.appendChild(span);

          recHtml += `<p class="text-xs text-slate-300">• 建議將「<span class="text-rose-400 font-bold">${m.word}</span>」替換為合法詞：「<span class="text-emerald-400 font-bold">${m.replace}</span>」</p>`;
        });
        recHtml += '</div>';
        recBox.innerHTML = recHtml;
        btnApply.classList.remove('hidden');
      }
    }

    // 自動洗白替換並套用
    function applyComplianceCleanText() {
      let text = document.getElementById('complianceInput').value;
      ILLEGAL_RULES.forEach(rule => {
        text = text.replaceAll(rule.word, rule.replace);
      });
      document.getElementById('complianceInput').value = text;
      currentItem.hook = currentItem.hook.replace(/消水腫/g, '舒緩護理').replace(/瘦臉/g, '線條按摩');
      renderCurrentVideoPackage();
      runComplianceScan();
      showToast('文案已自動完成法規洗白！');
    }

    // 財務精算
    function calcFinance() {
      const cny = parseFloat(document.getElementById('finCny').value) || 0;
      const fx = parseFloat(document.getElementById('finFx').value) || 4.6;
      const price = parseFloat(document.getElementById('finPrice').value) || 0;
      const shipping = parseFloat(document.getElementById('finShipping').value) || 0;

      const freeShip = document.getElementById('finFreeShip').checked;
      const coins = document.getElementById('finCoins').checked;

      const costTwd = cny * fx;
      const totalCost = costTwd + shipping;

      let rate = 8.0; // 基礎手續費 5.5% + 金流 2.5%
      if (freeShip) rate += 6.0;
      if (coins) rate += 3.0;
      if (freeShip && coins) rate -= 0.5;

      const invoiceFee = 2.5;
      const platformFee = (price * (rate / 100)) + invoiceFee;
      const netProfit = price - totalCost - platformFee;
      const margin = price > 0 ? ((netProfit / price) * 100).toFixed(1) : 0;
      const bep = (totalCost + invoiceFee) / (1 - (rate / 100));

      document.getElementById('resTotalCost').innerText = 'NT$ ' + totalCost.toFixed(1);
      document.getElementById('resTotalRate').innerText = rate.toFixed(1) + '%';
      document.getElementById('resFeeTotal').innerText = 'NT$ ' + platformFee.toFixed(1);
      document.getElementById('resNetProfit').innerText = 'NT$ ' + netProfit.toFixed(1);
      document.getElementById('resMargin').innerText = margin + '%';
      document.getElementById('resBep').innerText = 'NT$ ' + Math.ceil(bep);
    }

    // 複製全部分鏡
    function copyFullScript() {
      const fullText = `【帶貨短影音腳本：${currentItem.name}】\n\n[HOOK 誘餌]\n${currentItem.hook}\n\n[分鏡與口播]\n` + 
        currentItem.storyboard.map((s, i) => `第${i+1}段 (${s.time})\n畫面：${s.visual}\n口播：${s.audio}`).join('\n\n');
      
      copyStringToClipboard(fullText);
      showToast('15秒整套分鏡與口播腳本已複製到剪貼簿！');
    }

    function copyToClipboard(elementId, successMsg) {
      const text = document.getElementById(elementId).innerText || document.getElementById(elementId).value;
      copyStringToClipboard(text);
      showToast(successMsg);
    }

    function copyStringToClipboard(str) {
      const el = document.createElement('textarea');
      el.value = str;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
    }

    // 自訂 Toast 提示
    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastMessage');
      text.innerText = msg;
      toast.classList.remove('translate-y-[-150%]', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-[-150%]', 'opacity-0');
      }, 2500);
    }

    // 標籤切換器
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('text-brand-400', 'border-brand-500', 'font-bold');
        btn.classList.add('text-slate-400', 'border-transparent');
      });

      document.getElementById(tabId).classList.remove('hidden');
      const activeBtn = document.getElementById(`btn-${tabId}`);
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-400', 'border-transparent');
        activeBtn.classList.add('text-brand-400', 'border-brand-500', 'font-bold');
      }
    }
  </script>
</body>
</html>
